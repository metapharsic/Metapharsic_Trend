DATABASE_URL="postgresql://user:password@localhost:5432/trend_mr?schema=public"
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me"

# WhatsApp Cloud API — EOD report + daily summary send (web/lib/whatsapp.ts).
# Without these, sendWhatsAppMessage silently no-ops.
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""

# SMTP — daily summary email (web/lib/mailer.ts). Without these, sendEmail silently no-ops.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
